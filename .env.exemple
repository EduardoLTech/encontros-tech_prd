# ===========================================
# ENCONTROS TECH - VARIÁVEIS DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# URL completa de conexão com o banco PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql://encontros_tech:encontros_tech@localhost:5432/encontros_tech

# Credenciais específicas do PostgreSQL (usadas pelo docker-compose)
POSTGRES_USER=encontros_tech
POSTGRES_PASSWORD=encontros_tech
POSTGRES_DB=encontros_tech

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Título da aplicação (exibido na documentação da API)
APP_TITLE=Encontros Tech

# Modo debug (true para desenvolvimento, false para produção)
DEBUG=false

# Host e porta onde a aplicação será executada
HOST=0.0.0.0
PORT=8000

# ===========================================
# TELEMETRY CONFIGURATION
# ===========================================
# Nome do serviço para OpenTelemetry
SERVICE_NAME=encontros-tech

# Versão do serviço
SERVICE_VERSION=1.0.0

# Porta onde o Prometheus irá expor as métricas
PROMETHEUS_PORT=9090

# Diretório para métricas Prometheus em modo multiprocessing (Gunicorn)
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ===========================================
# HEALTH & READINESS
# ===========================================
# Teto de tempo da verificacao de prontidao de /ready, em segundos.
# Padrao 5. Piso efetivo 2 (a libpq eleva silenciosamente valores menores).
# Lido apenas na inicializacao: alterar exige reiniciar a aplicacao.
READINESS_DB_TIMEOUT_SECONDS=5

# ===========================================
# GUNICORN CONFIGURATION
# ===========================================
# Endereço e porta em que o Gunicorn escuta
GUNICORN_BIND=0.0.0.0:8000

# Número de workers (padrão: 2 * CPUs + 1)
GUNICORN_WORKERS=2

# Nível de log do Gunicorn
GUNICORN_LOG_LEVEL=info

# Threads por worker. Com worker class gthread, uma verificacao de prontidao
# bloqueada em I/O nao impede outra thread de responder /health (design D4).
GUNICORN_THREADS=4

# Recarga automática ao alterar o código-fonte (usar "true" em desenvolvimento)
GUNICORN_RELOAD=false